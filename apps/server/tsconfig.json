{
  "extends": "@elm-platform/tsconfig/node-nestjs.json",
  "compilerOptions": {
    "rootDirs": [
      "./src"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@common/*": [
        "./common/*"
      ],
      "@config/*": [
        "./config/*"
      ],
      "@prisma/*": [
        "./prisma/*"
      ],
      "@redis/*": [
        "./redis/*"
      ]
    },
    "outDir": "./dist"
  }
}
