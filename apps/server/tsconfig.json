{
  "extends": "@elm-platform/tsconfig/node-nestjs.json",
  "compilerOptions": {
    "rootDirs": [
      "./src"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@common/*": [
        "./src/common/*"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@prisma/*": [
        "./prisma/*"
      ],
      "@redis-service/*": [
        "./src/redis/*"
      ]
    },
    "outDir": "./dist"
  }
}
