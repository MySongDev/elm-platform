{
  "name": "elm-platform",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @elm-platform/server --filter @elm-platform/web-admin --filter @elm-platform/web-user --parallel run dev",
    "dev:server": "pnpm --filter @elm-platform/server run dev",
    "dev:admin": "pnpm --filter @elm-platform/web-admin run dev",
    "dev:user": "pnpm --filter @elm-platform/web-user run dev",
    "build": "turbo run build",
    "build:apps": "turbo run build --filter='./apps/*'",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:server": "turbo run build --filter=@elm-platform/server",
    "build:admin": "turbo run build --filter=@elm-platform/web-admin",
    "build:user": "turbo run build --filter=@elm-platform/web-user",
    "api:generate": "pnpm --filter @elm-platform/api-types run generate",
    "type-check": "turbo run type-check",
    "lint": "eslint . --fix --cache",
    "lint:style": "stylelint \"apps/{web-admin,web-user}/src/**/*.{vue,scss,css}\" --fix --config stylelint.config.mjs",
    "lint:all": "pnpm lint && pnpm lint:style",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:e2e": "pnpm --filter @elm-platform/server run prisma:generate && node scripts/run-playwright-e2e.mjs",
    "bundle:report": "pnpm build:admin && pnpm build:user && node scripts/report-bundle-size.mjs",
    "clean": "pnpm -r exec rm -rf node_modules dist .turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "conventional-changelog": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-recommended-vue": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "stylelint-order": "catalog:",
    "stylelint-scss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix --cache",
    "*.{vue,scss,css}": "stylelint --fix --config stylelint.config.mjs"
  }
}
